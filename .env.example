# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to look up recipient emails for notifications. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (no trailing slash). Used for magic links, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email notifications for connect requests (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Alumni Connect <noreply@yourdomain.com>"
